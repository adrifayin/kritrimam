# Waitlist delivery (src/lib/waitlist-store.ts)
#
# Copy to .env.local and fill in whichever transport you want. Both are
# optional and independent — configure one, both, or neither. With neither set,
# signups are logged to the server console and the form still succeeds, which
# is the intended local-development behaviour.
#
# Once ANY transport is configured, a delivery failure returns 502 to the
# visitor rather than silently dropping the signup.

# --- Email notification via Resend (https://resend.com) ---
# RESEND_API_KEY=re_xxxxxxxxxxxx
# Comma-separated list of recipients.
# WAITLIST_NOTIFY_TO=hello@kritrimam.com
# Must be a domain you have verified with Resend. Defaults to Resend's
# onboarding sender, which only delivers to your own account address.
# WAITLIST_NOTIFY_FROM=Kritrimam <waitlist@kritrimam.com>

# --- Generic JSON webhook (Zapier / Make / n8n / your own endpoint) ---
# WAITLIST_WEBHOOK_URL=https://hooks.example.com/waitlist
# Optional; sent as `Authorization: Bearer <token>`.
# WAITLIST_WEBHOOK_TOKEN=
